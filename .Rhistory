res_region5 <- c("Seoul", "Rest Capital", "Metros", "Provinces")
# (1) 해당 시도 출생자 기준(범례 숨김)
g_origin <- ggplot(d_org, aes(x = agegr, y = pop_signed, fill = res_region5)) +
geom_col(width = 0.9) +
coord_flip() +
y_scale +
scale_fill_manual(values = pal_comp, drop = FALSE, guide = "none") +
labs(title = paste0(REG, " origin"), x = NULL, y = NULL) +
base_theme
# (2) 해당 시도 거주자 기준(이 플롯의 범례만 사용, 제목 없음)
g_resident <- ggplot(d_res, aes(x = agegr, y = pop_signed, fill = org_region5)) +
geom_col(width = 0.9) +
coord_flip() +
y_scale +
scale_fill_manual(values = pal_comp, drop = TRUE, name = NULL) +  # 필요 시만 범례 항목 노출
labs(title = paste0(REG, " residents"), x = NULL, y = NULL) +
guides(fill = guide_legend(nrow = 2, byrow = TRUE)) +              # 범례 행 수 조정
base_theme
# 5) 시도별 그림 함수 --------------------------------------------------
make_pyramids_g5 <- function(REG) {
d_org <- pop2020 %>% filter(org_region5 == REG)   # 해당 지역 출생자
d_res <- pop2020 %>% filter(res_region5 == REG)   # 해당 지역 거주자
if (nrow(d_org) == 0 & nrow(d_res) == 0) {
message("Skip (no data): ", REG); return(invisible(NULL))
}
# 스택 합 기준 최대값 계산(양/음 별도) + 5% 여유
agg1 <- d_org %>% group_by(agegr) %>%
summarise(pos = sum(pmax(pop_signed, 0), na.rm = TRUE),
neg = sum(pmax(-pop_signed, 0), na.rm = TRUE), .groups = "drop")
agg2 <- d_res %>% group_by(agegr) %>%
summarise(pos = sum(pmax(pop_signed, 0), na.rm = TRUE),
neg = sum(pmax(-pop_signed, 0), na.rm = TRUE), .groups = "drop")
max_abs <- max(c(agg1$pos, agg1$neg, agg2$pos, agg2$neg), na.rm = TRUE) * 1.05
y_scale <- scale_y_continuous(
limits = c(-max_abs, max_abs),
labels = ~ comma(abs(.x)),
expand = expansion(mult = 0.01)
)
# (1) 해당 시도 출생자 기준(범례 숨김)
g_origin <- ggplot(d_org, aes(x = agegr, y = pop_signed, fill = res_region5)) +
geom_col(width = 0.9) +
coord_flip() +
y_scale +
scale_fill_manual(values = pal_comp, drop = FALSE, guide = "none") +
labs(title = paste0(REG, " origin"), x = NULL, y = NULL) +
base_theme
# (2) 해당 시도 거주자 기준(이 플롯의 범례만 사용, 제목 없음)
g_resident <- ggplot(d_res, aes(x = agegr, y = pop_signed, fill = org_region5)) +
geom_col(width = 0.9) +
coord_flip() +
y_scale +
scale_fill_manual(values = pal_comp, drop = TRUE, name = NULL) +  # 필요 시만 범례 항목 노출
labs(title = paste0(REG, " residents"), x = NULL, y = NULL) +
guides(fill = guide_legend(nrow = 2, byrow = TRUE)) +              # 범례 행 수 조정
base_theme
# 합치기(하단 중앙 단일 범례)
p <- (g_origin + g_resident) +
plot_layout(guides = "collect") &
theme(legend.position = "bottom", legend.justification = "center")
# 저장
slug <- gsub("[^A-Za-z0-9]+", "_", REG)
fn <- file.path("graphs", paste0("pmd_", slug, "_origin_res_2020.png"))
ggsave(fn, p, width = 10, height = 6, dpi = 300)
message("Saved: ", fn)
invisible(p)
}
res_region5 <- c("Seoul", "Rest Capital", "Metros", "Provinces")
# 6) 실행: 17개 시도 전체 --------------------------------------------
invisible(lapply(res_region5, make_pyramids_g5))
# 5) 시도별 그림 함수 --------------------------------------------------
make_pyramids_g5 <- function(REG) {
d_org <- pop2020 %>% filter(org_region5 == REG)   # 해당 지역 출생자
d_res <- pop2020 %>% filter(res_region5 == REG)   # 해당 지역 거주자
if (nrow(d_org) == 0 & nrow(d_res) == 0) {
message("Skip (no data): ", REG); return(invisible(NULL))
}
# 스택 합 기준 최대값 계산(양/음 별도) + 5% 여유
agg1 <- d_org %>% group_by(agegr) %>%
summarise(pos = sum(pmax(pop_signed, 0), na.rm = TRUE),
neg = sum(pmax(-pop_signed, 0), na.rm = TRUE), .groups = "drop")
agg2 <- d_res %>% group_by(agegr) %>%
summarise(pos = sum(pmax(pop_signed, 0), na.rm = TRUE),
neg = sum(pmax(-pop_signed, 0), na.rm = TRUE), .groups = "drop")
max_abs <- max(c(agg1$pos, agg1$neg, agg2$pos, agg2$neg), na.rm = TRUE) * 1.05
y_scale <- scale_y_continuous(
limits = c(-max_abs, max_abs),
labels = ~ comma(abs(.x)),
expand = expansion(mult = 0.01)
)
# (1) 해당 시도 출생자 기준(범례 숨김)
g_origin <- ggplot(d_org, aes(x = agegr, y = pop_signed, fill = res_region5)) +
geom_col(width = 0.9) +
coord_flip() +
y_scale +
scale_fill_manual(values = pal_comp, drop = FALSE, guide = "none") +
labs(title = paste0(REG, " origin"), x = NULL, y = NULL) +
base_theme
# (2) 해당 시도 거주자 기준(이 플롯의 범례만 사용, 제목 없음)
g_resident <- ggplot(d_res, aes(x = agegr, y = pop_signed, fill = org_region5)) +
geom_col(width = 0.9) +
coord_flip() +
y_scale +
scale_fill_manual(values = pal_comp, drop = TRUE, name = NULL) +  # 필요 시만 범례 항목 노출
labs(title = paste0(REG, " residents"), x = NULL, y = NULL) +
guides(fill = guide_legend(nrow = 2, byrow = TRUE)) +              # 범례 행 수 조정
base_theme
# 합치기(하단 중앙 단일 범례)
p <- (g_origin + g_resident) +
plot_layout(guides = "collect") &
theme(legend.position = "bottom", legend.justification = "center")
# 저장
slug <- gsub("[^A-Za-z0-9]+", "_", REG)
fn <- file.path("graphs", paste0("pmdregion_", slug, "_origin_res_2020.png"))
ggsave(fn, p, width = 10, height = 6, dpi = 300)
message("Saved: ", fn)
invisible(p)
}
res_region5 <- c("Seoul", "Rest Capital", "Metros", "Provinces")
# 6) 실행: 17개 시도 전체 --------------------------------------------
invisible(lapply(res_region5, make_pyramids_g5))
