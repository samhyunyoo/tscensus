geom_hline(data = hline_df, aes(yintercept = PPNYR),
color = "black", lty = "dotdash", linewidth = 0.7) +
scale_fill_manual(values = sex_colors) +
facet_wrap(. ~ gender) +
coord_flip() +
labs(
x = "",
y = "청년인구 잔류비율",
fill = "성별"
) +
theme_bw(base_size = 70) +
theme(
legend.position = "none",
text = element_text(family = "NanumGothic"),
axis.text.x = element_text(size = 65),
axis.text.y = element_text(size = 65),
strip.text  = element_text(size = 70),
axis.title  = element_text(size = 70)
)
p
ggsave("graphs/PPNYR_barplot.png",
plot = p,
width = 25,      # 더 크게
height = 18,
dpi = 320)
ggsave("graphs/PPNYR_barplot.png",
plot = p,
width = 20,      # 더 크게
height = 15,
dpi = 320)
