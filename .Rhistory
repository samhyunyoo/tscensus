Gangwon    = "강원도",
Chungbuk   = "충청북도",
Chungnam   = "충청남도",
Jeonbuk    = "전라북도",
Jeonnam    = "전라남도",
Gyeongbuk  = "경상북도",
Gyeongnam  = "경상남도",
Jeju       = "제주특별자치도"
)
